# --- App ---
FLASK_ENV=development
SECRET_KEY=change-me
LOG_LEVEL=INFO
# If set, every /api request needs header  X-RepoBloom-Token: <this value>
APP_ACCESS_TOKEN=

# --- Database ---
# PostgreSQL + pgvector (production):  postgresql+psycopg://user:password@host:5432/repobloom
# Leave empty to use local SQLite (repobloom.db) so the app runs out of the box.
DATABASE_URL=

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3

# --- Three independent model roles (any OpenRouter model id) ---
REPO_ANALYST_MODEL=qwen/qwen3.7-plus
REPO_ANALYST_MAX_TOKENS=2048
REPO_ANALYST_PRICE_IN=0
REPO_ANALYST_PRICE_OUT=0
CONTEXT_ANALYST_MODEL=qwen/qwen3.7-plus
CONTEXT_ANALYST_MAX_TOKENS=2048
CONTEXT_ANALYST_PRICE_IN=0
CONTEXT_ANALYST_PRICE_OUT=0
SYNTHESIZER_MODEL=qwen/qwen3.7-plus
SYNTHESIZER_MAX_TOKENS=3072
SYNTHESIZER_PRICE_IN=0
SYNTHESIZER_PRICE_OUT=0
# Prices are USD per 1M tokens, used only for cost estimates when OpenRouter does not report cost.

# --- Integrations ---
GITHUB_TOKEN=
GITHUB_MAX_COMMIT_DETAILS=40
DISCORD_BOT_TOKEN=
DISCORD_ANONYMIZE=true
DOCS_USER_AGENT=RepoBloomBot/1.0 (+https://github.com/your-org/repobloom)
